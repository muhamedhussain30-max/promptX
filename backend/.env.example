# ─────────────────────────────────────────────────────────────────────────────
# PromptX Prelims — Backend Environment Variables
# Copy to .env and fill in your values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME="PromptX Prelims"
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# CORS — JSON array of allowed frontend origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (local dev — no install needed):
DATABASE_URL=sqlite+aiosqlite:///./promptx_local.db
DATABASE_URL_SYNC=sqlite:///./promptx_local.db

# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://promptx:promptx@localhost:5432/promptx
# DATABASE_URL_SYNC=postgresql+psycopg2://promptx:promptx@localhost:5432/promptx

# ── Redis ──────────────────────────────────────────────────────────────────────
# Use fakeredis for local dev (no Redis server needed):
REDIS_URL=fakeredis://

# Real Redis (production):
# REDIS_URL=redis://localhost:6379/0

# ── AI Provider ────────────────────────────────────────────────────────────────
# Options:
#   mock         — no API keys needed, placeholder images (default)
#   nanobanana   — Nano Banana sync API — fastest option (get key at nananobanana.com)
#   huggingface  — FLUX.1-schnell image gen + Qwen2.5-VL vision scoring (free tier)
#   openai       — DALL-E 3 image gen + GPT-4o vision scoring (paid)

AI_PROVIDER=nanobanana
MOCK_GENERATION_DELAY=1.5

# ── Nano Banana (AI_PROVIDER=nanobanana) ──────────────────────────────────────
# Get your key at https://www.nananobanana.com → Settings → API Keys
# Sync mode: image ready in the same HTTP response — no polling, fastest option.
NANOBANANA_API_KEY=

# ── HuggingFace (AI_PROVIDER=huggingface) ─────────────────────────────────────
# Get your token at https://huggingface.co/settings/tokens
# Required permissions: "Inference Providers" (read)
# Used for:  FLUX.1-schnell image generation (free tier via fal-ai/replicate)
#            Qwen2.5-VL-3B-Instruct vision scoring (free tier via HF router)
HF_TOKEN=

# ── OpenAI (AI_PROVIDER=openai or for vision scoring fallback) ─────────────────
# Image generation: DALL-E 3
IMAGE_GENERATION_API_KEY=

# Vision scoring: GPT-4o
# If this starts with "sk-", the vision evaluator uses GPT-4o (overrides HF for scoring).
IMAGE_EVALUATION_API_KEY=

# ── Game defaults ──────────────────────────────────────────────────────────────
MAX_PLAYERS_PER_ROOM=70
DEFAULT_ROUND_DURATION=600    # seconds (10 minutes)
DEFAULT_MAX_ATTEMPTS=3
DEFAULT_ROUNDS=5
COUNTDOWN_SECONDS=5

# ── Security ───────────────────────────────────────────────────────────────────
# Change this in production — used to sign JWT tokens
# SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
